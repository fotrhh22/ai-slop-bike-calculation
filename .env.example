# Mac only. Copy to .env.local. Never put this token in station.js or GitHub.
BIKE_API_BASE=https://ai-slop-stop-api.onrender.com
# Same value as Render BIKE_WORKER_TOKEN; at least 32 random characters.
BIKE_WORKER_TOKEN=
# Optional: keep the original file path to continue existing station history.
# BIKE_DB_PATH=/absolute/path/to/station.sqlite3
